# --- Meta Graph API ---
# Leave META_GRAPH_BASE_URL unset to use the real API (https://graph.facebook.com).
# docker-compose points it at the bundled mock server by default.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_API_VERSION=v24.0
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
# Used for GET /webhooks/meta verification handshake (you choose this value in the App Dashboard)
META_WEBHOOK_VERIFY_TOKEN=change-me

# Optional product IDs
WHATSAPP_PHONE_NUMBER_ID=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# --- Client behaviour ---
META_TIMEOUT_SECONDS=15
META_MAX_RETRIES=3
META_CIRCUIT_FAILURE_THRESHOLD=5
META_CIRCUIT_RESET_SECONDS=30

# --- Observability ---
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=meta-api-tester
