# --- Meta Graph API ---
# Leave META_GRAPH_BASE_URL unset to use the real API (https://graph.facebook.com).
# docker-compose points it at the bundled mock server by default.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_API_VERSION=v24.0
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
# Used for GET /webhooks/meta verification handshake (you choose this value in the App Dashboard)
META_WEBHOOK_VERIFY_TOKEN=change-me

# Optional product IDs
WHATSAPP_PHONE_NUMBER_ID=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# --- Client behaviour ---
META_TIMEOUT_SECONDS=15
META_MAX_RETRIES=3
META_CIRCUIT_FAILURE_THRESHOLD=5
META_CIRCUIT_RESET_SECONDS=30

# --- Observability ---
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=meta-api-tester

# --- Alerting ---
# Slack incoming webhook (https://api.slack.com/messaging/webhooks). Unset = mock's fake Slack
# endpoint (view messages at http://localhost:8081/_mock/slack).
SLACK_WEBHOOK_URL=

# --- Audit ---
# Comma-separated name:key pairs. When set, /api/* requires X-API-Key and the name is the audited actor.
APP_API_KEYS=
AUDIT_LOG_PATH=data/audit.jsonl

# --- Audit archive (S3 Object Lock) ---
# Unset AUDIT_S3_ENDPOINT_URL = local LocalStack. Set it to EMPTY for real AWS (see infra/audit-bucket).
# AUDIT_S3_ENDPOINT_URL=
AUDIT_S3_BUCKET=meta-audit-local
AUDIT_S3_PREFIX=audit/meta-api-tester
AUDIT_S3_REGION=us-east-1
AUDIT_S3_LOCK_MODE=COMPLIANCE
AUDIT_S3_RETENTION_DAYS=1
AUDIT_S3_KMS_KEY_ID=
# Shipper-only credentials (prefer an instance/task role in AWS and leave these unset there).
AUDIT_AWS_ACCESS_KEY_ID=
AUDIT_AWS_SECRET_ACCESS_KEY=

# Synchronous journal (fail-closed): app -> audit gateway -> S3 Object Lock before every action.
# Empty AUDIT_JOURNAL_URL = batched shipping only. Use a long random token outside local dev.
# AUDIT_JOURNAL_URL=http://audit-shipper:9102
AUDIT_JOURNAL_TOKEN=
AUDIT_JOURNAL_TIMEOUT_SECONDS=2
